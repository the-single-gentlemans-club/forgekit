{
  "name": "@forgekit/figma-plugin",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./manifest.json": "./manifest.json",
    ".": {
      "@forgekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npx tsup src/index.ts --format esm --dts --clean --tsconfig tsconfig.build.json && cp manifest.json dist/manifest.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "publish:npm": "npm publish --access public"
  },
  "files": [
    "dist",
    "manifest.json",
    "!**/*.tsbuildinfo"
  ],
  "peerDependenciesMeta": {
    "@figma/plugin-typings": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {}
}
