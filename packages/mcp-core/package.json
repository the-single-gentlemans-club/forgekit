{
  "name": "@forgekit/mcp-core",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mcp-core": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@forgekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npx tsup src/index.ts src/cli.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "publish:npm": "npm publish --access public"
  },
  "nx": {
    "tags": [
      "type:mcp",
      "scope:shared"
    ]
  },
  "dependencies": {},
  "devDependencies": {}
}
