{
  "name": "forgekit-figma-mcp",
  "version": "0.1.0",
  "description": "MCP server for syncing Figma tokens to Design Systems (Chakra, Tailwind, Docs)",
  "author": "Rich Tillman <richtillman@gmail.com>",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "forgekit": "./dist/cli.js"
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@forgekit/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npx tsup src/index.ts src/cli.ts --format esm --dts --clean --tsconfig tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "publish:npm": "npm publish --access public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "nx": {
    "tags": [
      "type:mcp",
      "scope:figma"
    ]
  },
  "dependencies": {},
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "chakra-ui",
    "figma",
    "mcp",
    "design-tokens",
    "theme-sync"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/effinrich/forgekit.git"
  },
  "homepage": "https://forgekit.cloud"
}
