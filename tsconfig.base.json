{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "customConditions": ["@forgekit/source"],
    "paths": {
      "@forgekit/design-system": ["packages/design-system/src/components/ui/index"],
      "@forgekit/mcp-core": ["packages/mcp-core/src/index"],
      "@/lib/utils": ["packages/utils/src/index"]
    }
  }
}
